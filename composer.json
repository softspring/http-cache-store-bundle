{
    "name": "softspring/http-cache-store-bundle",
    "description": "This is a template for creating new components",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "psr/cache": "^3.0",
        "rector/rector": "^2.2",
        "symfony/cache": "^6.4|^7.3",
        "symfony/config": "^6.4|^7.3",
        "symfony/dependency-injection": "^6.4|^7.3",
        "symfony/http-kernel": "^6.4|^7.3"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Bundle\\HttpCacheStoreBundle\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    }
}
